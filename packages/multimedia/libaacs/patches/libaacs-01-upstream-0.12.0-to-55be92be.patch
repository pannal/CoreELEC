+
+static AACS_CCI *_read_cci(AACS *aacs, int cps_unit)
+{
+    AACS_CCI *cci;
+    void     *data;
+    size_t    size;
+
+    size = _read_cci_file(aacs, cps_unit, &data);
+    if (!size) {
+        BD_DEBUG(DBG_AACS | DBG_CRIT, "Failed to read CPS unit usage file %d\n", cps_unit);
+        return NULL;
+    }
+
+    cci = cci_parse(data, size);
+    X_FREE(data);
+
+    return cci;
