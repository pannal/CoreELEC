+bool CCECClient::SetCurrentPowerButton(const cec_command &command, bool bPowerOn)
+{
+  CLockObject lock(m_mutex);
+  ExpirePowerButton();
+  bool suspendAware;
+  const int64_t powerTime = GetPowerButtonTimeMs(suspendAware);
+  const cec_user_control_code button = (cec_user_control_code)command.parameters[0];
+  const cec_user_control_code previous = m_powerButton.powerOn ?
+      CEC_USER_CONTROL_CODE_POWER_ON_FUNCTION : m_powerButton.key;
+
+  // A held toggle retains its initial meaning after activation changes the
+  // device state. Reuse the existing release deadline, including a lost release.
+  if (m_powerButton.key == button &&
+      m_powerButton.initiator == command.initiator &&
+      m_powerButton.destination == command.destination &&
+      m_iCurrentButton == previous && m_releaseButtontime > GetTimeMs())
+    bPowerOn = m_powerButton.powerOn;
+
+  // Keep press/repeat/release tracking, but never expose an activation as a
+  // shutdown-capable toggle. Explicit Power Off and other input stay unchanged.
+  cec_keypress key;
+  key.duration = 0;
+  key.keycode = bPowerOn ? CEC_USER_CONTROL_CODE_POWER_ON_FUNCTION : button;
+  LIB_CEC->AddLog(CEC_LOG_DEBUG, "power toggle %02x from %x to %x means %s",
+      button, command.initiator, command.destination, bPowerOn ? "on" : "off");
+  AddKey(key);
+  m_powerButton.key = button;
+  m_powerButton.initiator = command.initiator;
+  m_powerButton.destination = command.destination;
+  m_powerButton.powerOn = bPowerOn;
+  m_powerButton.releaseTime = powerTime + std::max<int64_t>(0, m_releaseButtontime - GetTimeMs());
+  m_powerButton.suspendAware = suspendAware;
+  return bPowerOn;
+}
+
+void CCECClient::ReleaseCurrentButton(const cec_command &command, bool bButtonRelease)
+{
+  CLockObject lock(m_mutex);
+  ExpirePowerButton();
+  const cec_user_control_code button = m_powerButton.powerOn ?
+      CEC_USER_CONTROL_CODE_POWER_ON_FUNCTION : m_powerButton.key;
+  if (m_powerButton.key != CEC_USER_CONTROL_CODE_UNKNOWN && m_iCurrentButton == button &&
+      (m_powerButton.initiator != command.initiator ||
+       m_powerButton.destination != command.destination))
+    return;
+
+  AddKey(false, bButtonRelease);
+  m_powerButton = PowerButtonState();
+}
+
+void CCECClient::ExpirePowerButton(void)
+{
+  // Caller holds m_mutex. Also cover direct AddKey callers and the timeout
+  // pump: after suspend, an ordinary key or release must not flush an old Off.
+  if (m_powerButton.key == CEC_USER_CONTROL_CODE_UNKNOWN)
+    return;
+  const cec_user_control_code button = m_powerButton.powerOn ?
+      CEC_USER_CONTROL_CODE_POWER_ON_FUNCTION : m_powerButton.key;
+  if (m_iCurrentButton != button)
+  {
+    m_powerButton = PowerButtonState();
+    return;
+  }
+
+  // The regular monotonic key clock stops during sleep. Retained clients must
+  // additionally expire the same release interval against suspend-aware time.
+  bool suspendAware;
+  const int64_t powerTime = GetPowerButtonTimeMs(suspendAware);
+  if (m_powerButton.suspendAware != suspendAware ||
+      m_powerButton.releaseTime <= powerTime || m_releaseButtontime <= GetTimeMs())
+    ResetKeypress();
+}
+
+void CCECClient::ResetKeypress(void)
+{
+  // Caller holds m_mutex. Callback retirement discards the old session queue.
+  m_powerButton = PowerButtonState();
+  m_iCurrentButton = CEC_USER_CONTROL_CODE_UNKNOWN;
+  m_initialButtontime = 0;
+  m_updateButtontime = 0;
+  m_repeatButtontime = 0;
+  m_releaseButtontime = 0;
+  m_pressedButtoncount = 0;
+  m_releasedButtoncount = 0;
+}
+
 uint16_t CCECClient::CheckKeypressTimeout(void)
 {
+  CLockObject lock(m_mutex);
+  ExpirePowerButton();
   // time when we'd like to be called again
   uint64_t timeout = CEC_PROCESSOR_SIGNAL_WAIT_TIME;
   cec_keypress key;
