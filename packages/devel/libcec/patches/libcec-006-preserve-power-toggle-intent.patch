+static int64_t GetPowerButtonTimeMs(bool &suspendAware)
+{
+#if defined(CLOCK_BOOTTIME)
+  struct timespec time;
+  if (clock_gettime(CLOCK_BOOTTIME, &time) == 0)
+  {
+    suspendAware = true;
+    return (int64_t)time.tv_sec * 1000 + time.tv_nsec / 1000000;
+  }
+#endif
+  suspendAware = false;
+  return GetTimeMs();
+}
 
