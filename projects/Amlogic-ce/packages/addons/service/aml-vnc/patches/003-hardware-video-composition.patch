+uint32_t *vncBuffer;
+rfbScreenInfoPtr vncScreen;
+int includeVideo;
+static int captures;
+
+int updateScreenFull(void) {
+	captures++;
+	assert(!includeVideo || (kodiGuiReady && hasFbdevViewer()));
+	return 1;
+}
+
+void fbdev_updateScreenFormat(void) {
+	screenFormat.width = screenInfo.width;
+	screenFormat.height = screenInfo.height;
+	screenFormat.bitsPerPixel = 32;
+	screenFormat.redMax = screenFormat.greenMax = screenFormat.blueMax = 8;
+}
+
+void rfbNewFramebuffer(rfbScreenInfoPtr screen, char *pixels, int width, int height,
+		int bits, int samples, int bytes) {
+	screen->frameBuffer = pixels;
+}
+
+void rfbCloseClient(rfbClientPtr client) { client->sock = RFB_INVALID_SOCKET; }
+void rfbClientConnectionGone(rfbClientPtr client) { vncScreen->clientHead = client->next; }
+void releasePointerButtons(void) {}
+static rfbBool translate(rfbClientPtr client) { return TRUE; }
+rfbBool rfbUpdateClient(rfbClientPtr client) {
+	assert(vncScreen->maxClientWait == (includeVideo ? 1000 : 20000));
+	return TRUE;
+}
+
+int main(void) {
+	rfbScreenInfo screen = {0};
+	rfbClientRec client = {0};
+	vncScreen = &screen;
+	screen.setTranslateFunction = translate;
+	screen.maxClientWait = 20000;
+	includeVideo = 1;
+	updateFbdevClient(&client);
+	assert(screen.maxClientWait == 20000);
+	screenInfo.width = 3840;
+	screenInfo.height = 2160;
+	assert(!resizeFbdevDesktop(0));
+	assert(!captures && kodiGuiRefresh);
+	screenInfo.width = 1920;
+	screenInfo.height = 1080;
+	client.screen = client.scaledScreen = &screen;
+	client.state = RFB_NORMAL;
+	client.useNewFBSize = TRUE;
+	screen.clientHead = &client;
+	assert(!resizeFbdevDesktop(0));
+	assert(!captures && kodiGuiRefresh);
+	kodiGuiReady = 1;
+	assert(!resizeFbdevDesktop(0));
+	assert(captures == 1 && !kodiGuiRefresh);
+	client.useNewFBSize = FALSE;
+	screenInfo.width = 720;
+	screenInfo.height = 480;
+	assert(!resizeFbdevDesktop(0));
+	assert(!hasFbdevViewer() && captures == 1 && kodiGuiRefresh);
+	screen.clientHead = NULL;
+	kodiGuiReady = 0;
+	screenInfo.width = 3840;
+	screenInfo.height = 2160;
+	assert(!resizeFbdevDesktop(0));
+	assert(captures == 1 && kodiGuiRefresh);
+	includeVideo = 0;
+	updateFbdevClient(&client);
+	assert(screen.maxClientWait == 20000);
+	assert(!resizeFbdevDesktop(0));
+	assert(captures == 2 && !kodiGuiRefresh);
+	free(vncBuffer);
+	return 0;
+}
