diff -ruN baseline-source/tests/test_write.c source/tests/test_write.c
--- baseline-source/tests/test_write.c	1969-12-31 16:00:00.000000000 -0800
+++ source/tests/test_write.c	2026-11-24 07:31:54.971628000 -0800
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <rfb/rfb.h>
+#undef LIBVNCSERVER_WITH_WEBSOCKETS
+#undef LIBVNCSERVER_WITH_SYSTEMD
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wrestrict"
+#pragma GCC diagnostic ignored "-Wunused-result"
+#include "../../deps/source/src/libvncserver/sockets.c"
+#pragma GCC diagnostic pop
+#include <assert.h>
+#include <stdatomic.h>
+#include <pthread.h>
+
+static void ignore_log(const char *format, ...) {}
+rfbLogProc rfbLog = ignore_log, rfbErr = ignore_log;
+void rfbLogPerror(const char *text) {}
+
+typedef struct {
+	int fd, slow;
+	_Atomic int stop;
+	size_t bytes;
+} reader_t;
+
+static void *receive_bytes(void *opaque) {
+	reader_t *reader = opaque;
+	unsigned char bytes[65536];
+	while (!atomic_load(&reader->stop)) {
+		ssize_t count = read(reader->fd, bytes, reader->slow ? 256 : sizeof(bytes));
+		if (count > 0) {
+			for (ssize_t i = 0; i < count; i++)
+				assert(bytes[i] == 0x5a);
+			reader->bytes += count;
+		}
+		struct timespec pause = {0, reader->slow ? 20000000 : 100000};
+		nanosleep(&pause, NULL);
+	}
+	return NULL;
+}
+
+static double seconds(void) {
+	struct timespec now;
+	assert(!clock_gettime(CLOCK_MONOTONIC, &now));
+	return now.tv_sec + now.tv_nsec / 1e9;
+}
+
+static void check_write(int mode) {
+	int sockets[2], capacity = 4096;
+	assert(!socketpair(AF_UNIX, SOCK_STREAM, 0, sockets));
+	for (int i = 0; i < 2; i++)
+		assert(!fcntl(sockets[i], F_SETFL, O_NONBLOCK));
+	assert(!setsockopt(sockets[0], SOL_SOCKET, SO_SNDBUF, &capacity, sizeof(capacity)));
+	rfbScreenInfo screen = {0};
+	screen.maxClientWait = 1000;
+	rfbClientRec client = {0};
+	client.screen = &screen;
+	client.sock = sockets[0];
+	INIT_MUTEX(client.outputMutex);
+	reader_t reader = {.fd = sockets[1], .slow = mode == 1};
+	pthread_t thread;
+	if (mode)
+		assert(!pthread_create(&thread, NULL, receive_bytes, &reader));
+	size_t size = mode == 2 ? 262144 : 8388608;
+	char *data = malloc(size);
+	assert(data);
+	memset(data, 0x5a, size);
+	double start = seconds();
+	int result = rfbWriteExact(&client, data, size);
+	int error = errno;
+	double elapsed = seconds() - start;
+	if (mode == 2) {
+		assert(result == 1 && elapsed < 1.5);
+	} else {
+		assert(result == -1 && error == ETIMEDOUT);
+		assert(elapsed >= .8 && elapsed < 1.5);
+	}
+	if (mode) {
+		atomic_store(&reader.stop, 1);
+		assert(!pthread_join(thread, NULL));
+		assert(reader.bytes > 0);
+	}
+	printf("write mode=%d elapsed=%.3f result=%d\n", mode, elapsed, result);
+	free(data);
+	TINI_MUTEX(client.outputMutex);
+	close(sockets[0]);
+	close(sockets[1]);
+}
+
+int main(void) {
+	check_write(0);
+	check_write(1);
+	check_write(2);
+	return 0;
+}
