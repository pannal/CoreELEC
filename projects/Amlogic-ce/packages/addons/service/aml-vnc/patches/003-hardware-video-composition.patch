+	assert(video_map_axis(-1, 0, 719, 479, 720, 480, 720, 480,
+		&left, &top, &width, &height) == -1);
+	assert(video_map_axis(0, 0, 720, 479, 720, 480, 720, 480,
+		&left, &top, &width, &height) == -1);
+	video_blend_image(output, gui, red, 2, 2, 1, 1, 1, 1, 1, 1, 16, 8, 0, 24);
