diff -ruN baseline-source/backend/video_math.h source/backend/video_math.h
--- baseline-source/backend/video_math.h	1969-12-31 16:00:00.000000000 -0800
+++ source/backend/video_math.h	2026-11-24 00:43:31.984874600 -0800
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#ifndef VIDEO_MATH_H
+#define VIDEO_MATH_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+static inline int video_map_axis(int x, int y, int right, int bottom,
+		unsigned int physical_width, unsigned int physical_height,
+		unsigned int gui_width, unsigned int gui_height,
+		unsigned int *left, unsigned int *top,
+		unsigned int *width, unsigned int *height) {
+	if (!physical_width || !physical_height || !gui_width || !gui_height ||
+	    x < 0 || y < 0 || right < x || bottom < y ||
+	    (unsigned int)right >= physical_width || (unsigned int)bottom >= physical_height)
+		return -1;
+	*left = (uint64_t)x * gui_width / physical_width;
+	*top = (uint64_t)y * gui_height / physical_height;
+	unsigned int end_x = (((uint64_t)right + 1) * gui_width + physical_width - 1) / physical_width;
+	unsigned int end_y = (((uint64_t)bottom + 1) * gui_height + physical_height - 1) / physical_height;
+	*width = end_x - *left;
+	*height = end_y - *top;
+	return 0;
+}
+
+static inline uint32_t video_blend_pixel(uint32_t gui, const unsigned char *bgr,
+		unsigned int red, unsigned int green, unsigned int blue, unsigned int alpha) {
+	const unsigned int shifts[] = {red, green, blue};
+	const unsigned int a = (gui >> alpha) & 255;
+	if (a == 255)
+		return gui;
+	if (!a)
+		return (255u << alpha) | ((uint32_t)bgr[2] << red) |
+			((uint32_t)bgr[1] << green) | ((uint32_t)bgr[0] << blue);
+	uint32_t result = 255u << alpha;
+	for (unsigned int c = 0; c < 3; c++) {
+		unsigned int value = a ? (gui >> shifts[c]) & 255 : 0;
+		value += (bgr[2 - c] * (255 - a) + 127) / 255;
+		result |= (value > 255 ? 255 : value) << shifts[c];
+	}
+	return result;
+}
+
+static inline void video_blend_image(uint32_t *output, const uint32_t *gui,
+		const unsigned char *bgr, unsigned int width, unsigned int height,
+		unsigned int capture_width, unsigned int capture_height,
+		unsigned int left, unsigned int top, unsigned int video_width, unsigned int video_height,
+		unsigned int red, unsigned int green,
+		unsigned int blue, unsigned int alpha) {
+	const unsigned char black[3] = {0, 0, 0};
+	for (unsigned int y = 0; y < height; y++) {
+		for (unsigned int x = 0; x < width; x++) {
+			const unsigned char *background = black;
+			if (x >= left && x - left < video_width &&
+			    y >= top && y - top < video_height) {
+				size_t sx = (uint64_t)(x - left) * capture_width / video_width;
+				size_t sy = (uint64_t)(y - top) * capture_height / video_height;
+				background = bgr + (sy * capture_width + sx) * 3;
+			}
+			output[(size_t)y * width + x] = video_blend_pixel(
+				gui[(size_t)y * width + x], background, red, green, blue, alpha);
+		}
+	}
+}
+
+#endif
