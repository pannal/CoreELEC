diff -ruN baseline-source/backend/video.c source/backend/video.c
--- baseline-source/backend/video.c	1969-12-31 16:00:00.000000000 -0800
+++ source/backend/video.c	2026-11-24 00:43:31.971966600 -0800
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+// Experimental pre-HDMI SDR composition; no compressed-primary readback.
+#include "video.h"
+#include "video_math.h"
+#include "framebuffer.h"
+#include <sys/file.h>
+#include <ctype.h>
+
+#define MAX_PIXELS (1920u * 1080u)
+
+int includeVideo = 0;
+static int videoFd = -1, lockFd = -1;
+static unsigned int captureWidth, captureHeight;
+static uint32_t *guiPixels, *outputPixels;
+static unsigned char *videoPixels;
+static size_t capacity;
+static int previousPresence = -1;
+static time_t unavailableSince;
+
+static int readState(const char *path, char *value, size_t size) {
+	FILE *file = fopen(path, "r");
+	if (!file) {
+		LOG(" Video composition: cannot open %s: %s.\n", path, strerror(errno));
+		return -1;
+	}
+	size_t count = fread(value, 1, size - 1, file);
+	int failed = ferror(file);
+	fclose(file);
+	value[count] = 0;
+	if (failed || !count) {
+		LOG(" Video composition: empty/unreadable state %s.\n", path);
+		return -1;
+	}
+	return 0;
+}
+
+static int setCapture(unsigned int command, unsigned long value) {
+	if (ioctl(videoFd, command, value) < 0) {
+		LOG(" Video composition: capture ioctl failed: %s.\n", strerror(errno));
+		return -1;
+	}
+	return 0;
+}
+
+static int configureCapture(unsigned int width, unsigned int height) {
+	if (videoFd >= 0 && captureWidth == width && captureHeight == height)
+		return 0;
+	if (videoFd < 0) {
+		videoFd = open("/dev/amvideocap0", O_RDWR | O_NONBLOCK | O_CLOEXEC);
+		if (videoFd < 0) {
+			LOG(" Video composition: open amvideocap0 failed: %s.\n", strerror(errno));
+			return -1;
+		}
+	}
+	if (setCapture(_IOW('V', 2, int), width) ||
+	    setCapture(_IOW('V', 3, int), height) ||
+	    setCapture(_IOW('V', 5, uint64_t), 100) ||
+	    setCapture(_IOW('V', 6, int), 0))
+		return -1;
+	captureWidth = width;
+	captureHeight = height;
+	return 0;
+}
+
+void video_close(void) {
+	if (videoFd >= 0)
+		close(videoFd);
+	if (lockFd >= 0)
+		close(lockFd);
+	videoFd = lockFd = -1;
+	captureWidth = captureHeight = 0;
+	free(guiPixels);
+	free(outputPixels);
+	free(videoPixels);
+	guiPixels = outputPixels = NULL;
+	videoPixels = NULL;
+	capacity = 0;
+	previousPresence = -1;
+	unavailableSince = 0;
+}
+
+int video_read_frame(const uint32_t **pixels) {
+	if (activeBackend != BACKEND_FBDEV) {
+		LOG(" Video composition requires the p3i FBDEV backend.\n");
+		return -1;
+	}
+	if (lockFd < 0) {
+		lockFd = open("/run/display-streaming-capture.lock",
+			O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+		if (lockFd < 0 || flock(lockFd, LOCK_EX | LOCK_NB)) {
+			LOG(" Video composition: another display capture owns the device, or lock failed.\n");
+			return -1;
+		}
+		LOG(" Video composition enabled: independent linear GUI + decoded SDR video, before HDMI; not AFBC/HDR/scanout fidelity.\n");
+	}
+	const unsigned int width = screenInfo.width, height = screenInfo.height;
+	const unsigned int alignedWidth = (width + 31u) & ~31u;
+	if (!width || !height || width > 1920 || height > 1080 ||
+	    (uint64_t)alignedWidth * height > MAX_PIXELS) {
+		LOG(" Video composition: unsupported GUI size %ux%u (maximum 1920x1080).\n", width, height);
+		return -1;
+	}
+	size_t size = (size_t)alignedWidth * height;
+	if (size > capacity) {
+		uint32_t *gui = malloc(size * sizeof(*gui));
+		uint32_t *output = malloc(size * sizeof(*output));
+		unsigned char *video = malloc(size * 3);
+		if (!gui || !output || !video) {
+			free(gui); free(output); free(video);
+			LOG(" Video composition: bounded frame allocation failed.\n");
+			return -1;
+		}
+		free(guiPixels); free(outputPixels); free(videoPixels);
+		guiPixels = gui;
+		outputPixels = output;
+		videoPixels = video;
+		capacity = size;
+	}
+	char state[4096], *end;
+	if (readState("/sys/class/video/disable_video", state, sizeof(state)))
+		return -1;
+	errno = 0;
+	long disabled = strtol(state, &end, 10);
+	while (isspace((unsigned char)*end))
+		end++;
+	if (errno || end == state || *end || disabled < 0 || disabled > 2) {
+		LOG(" Video composition: invalid video visibility state.\n");
+		return -1;
+	}
+	int present = 0;
+	unsigned int left = 0, top = 0, videoWidth = width, videoHeight = height;
+	unsigned int readWidth = alignedWidth, readHeight = height;
+	if (!disabled) {
+		if (readState("/sys/class/video/frame_format", state, sizeof(state)))
+			return -1;
+		if (strstr(state, "Compressed")) {
+			LOG(" Video composition refused: compressed video has no qualified readback. Disable Include video; decoder settings were not changed.\n");
+			return -1;
+		}
+		if (!strcmp(state, "NA\n"))
+			goto noVideo;
+		if (readState("/sys/class/video/axis", state, sizeof(state)))
+			return -1;
+		int x, y, right, bottom;
+		if (sscanf(state, "%d %d %d %d", &x, &y, &right, &bottom) != 4 ||
+		    readState("/sys/class/display/vinfo", state, sizeof(state))) {
+			LOG(" Video composition: unavailable video/output geometry.\n");
+			return -1;
+		}
+		char *w = strstr(state, "width:"), *h = strstr(state, "height:");
+		unsigned int physicalWidth, physicalHeight;
+		if (!w || !h || sscanf(w, "width: %u", &physicalWidth) != 1 ||
+		    sscanf(h, "height: %u", &physicalHeight) != 1 ||
+		    physicalWidth > 8192 || physicalHeight > 8192 ||
+		    video_map_axis(x, y, right, bottom, physicalWidth, physicalHeight,
+			width, height, &left, &top, &videoWidth, &videoHeight)) {
+			LOG(" Video composition refused: unsupported physical video-axis geometry.\n");
+			return -1;
+		}
+		if (readState("/sys/class/video/crop", state, sizeof(state)))
+			return -1;
+		int a, b, c, d;
+		if (sscanf(state, "%d %d %d %d", &a, &b, &c, &d) != 4 || a || b || c || d ||
+		    readState("/sys/class/video/screen_mode", state, sizeof(state)) ||
+		    strncmp(state, "1:", 2) ||
+		    readState("/sys/class/video/global_offset", state, sizeof(state)) ||
+		    sscanf(state, "%d %d", &a, &b) != 2 || a || b) {
+			LOG(" Video composition refused: unsupported crop/aspect transform (only the video-axis/full-stretch path is qualified).\n");
+			return -1;
+		}
+		readWidth = (videoWidth + 31u) & ~31u;
+		readHeight = videoHeight;
+		if (configureCapture(readWidth, readHeight))
+			return -1;
+		size_t bytes = (size_t)readWidth * readHeight * 3;
+		ssize_t count = pread(videoFd, videoPixels, bytes, 0);
+		if (count == (ssize_t)bytes) {
+			present = 1;
+			unavailableSince = 0;
+		} else if (count < 0 && (errno == EAGAIN || errno == ENODATA)) {
+			struct timespec now;
+			if (clock_gettime(CLOCK_MONOTONIC, &now)) {
+				LOG(" Video composition: cannot obtain capture deadline clock.\n");
+				return -1;
+			}
+			if (!unavailableSince) {
+				unavailableSince = now.tv_sec;
+				LOG(" Video composition: frame unavailable during transition; skipping updates.\n");
+			} else if (now.tv_sec - unavailableSince >= 5) {
+				LOG(" Video composition stopped: no readable video frame for five seconds.\n");
+				return -1;
+			}
+			return 1;
+		} else {
+			LOG(" Video composition: short/failed video read (%zd/%zu): %s.\n",
+				count, bytes, count < 0 ? strerror(errno) : "short frame");
+			return -1;
+		}
+		if (readState("/sys/class/video/axis", state, sizeof(state)))
+			return -1;
+		int afterX, afterY, afterRight, afterBottom;
+		if (sscanf(state, "%d %d %d %d", &afterX, &afterY, &afterRight, &afterBottom) != 4) {
+			LOG(" Video composition: invalid post-capture video axis.\n");
+			return -1;
+		}
+		if (x != afterX || y != afterY || right != afterRight || bottom != afterBottom)
+			return 1;
+	} else {
+noVideo:
+		memset(videoPixels, 0, size * 3);
+		unavailableSince = 0;
+	}
+	struct fb_var_screeninfo layout;
+	int copied = fbdev_snapshot(guiPixels, capacity, &layout);
+	if (copied)
+		return copied;
+	video_blend_image(outputPixels, guiPixels, videoPixels, width, height,
+		readWidth, readHeight, left, top, videoWidth, videoHeight,
+		layout.red.offset, layout.green.offset, layout.blue.offset,
+		layout.transp.offset);
+	if (previousPresence != present) {
+		LOG(" Video composition: decoded video present=%d.\n", present);
+		previousPresence = present;
+	}
+	*pixels = outputPixels;
+	return 0;
+}
