diff -ruN baseline-source/backend/fbdev.c source/backend/fbdev.c
--- baseline-source/backend/fbdev.c	2026-11-24 00:13:31.372494869 -0800
+++ source/backend/fbdev.c	2026-11-24 00:43:31.960444700 -0800
@@ -114,3 +114,41 @@
 uint32_t *fbdev_readFrameBuffer(void) {
 	return (uint32_t *)fbBufferMap + varInfo.xoffset;
 }
+
+int fbdev_snapshot(uint32_t *pixels, size_t capacity, struct fb_var_screeninfo *layout) {
+	struct fb_var_screeninfo before, after;
+	if (ioctl(fbFd, FBIOGET_VSCREENINFO, &before) < 0) {
+		LOG(" Video composition: cannot read GUI layout: %s.\n", strerror(errno));
+		return -1;
+	}
+	if (!sameLayout(&varInfo, &before))
+		return 1;
+	if ((size_t)before.xres * before.yres > capacity ||
+	    ((uint64_t)before.yoffset + before.yres) * screenInfo.stride > fbSize ||
+	    ((uint64_t)before.xoffset + before.xres) * sizeof(*pixels) > screenInfo.stride ||
+	    before.red.length != 8 || before.green.length != 8 ||
+	    before.blue.length != 8 || before.transp.length != 8 ||
+	    before.red.offset > 24 || before.green.offset > 24 ||
+	    before.blue.offset > 24 || before.transp.offset > 24 ||
+	    before.red.msb_right || before.green.msb_right ||
+	    before.blue.msb_right || before.transp.msb_right ||
+	    ((255u << before.red.offset) | (255u << before.green.offset) |
+	     (255u << before.blue.offset) | (255u << before.transp.offset)) != UINT32_MAX) {
+		LOG(" Video composition requires a supported premultiplied RGBA GUI.\n");
+		return -1;
+	}
+	for (size_t y = 0; y < before.yres; y++)
+		memcpy(pixels + y * before.xres,
+			(const unsigned char *)fbBufferMap + (y + before.yoffset) * screenInfo.stride +
+			before.xoffset * sizeof(*pixels), before.xres * sizeof(*pixels));
+	if (ioctl(fbFd, FBIOGET_VSCREENINFO, &after) < 0) {
+		LOG(" Video composition: cannot validate GUI snapshot: %s.\n", strerror(errno));
+		return -1;
+	}
+	if (!sameLayout(&before, &after) || before.xoffset != after.xoffset ||
+	    before.yoffset != after.yoffset ||
+	    memcmp(&before.transp, &after.transp, sizeof(before.transp)))
+		return 1;
+	*layout = before;
+	return 0;
+}
