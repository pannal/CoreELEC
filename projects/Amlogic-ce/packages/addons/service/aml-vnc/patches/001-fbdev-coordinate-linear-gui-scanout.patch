+// Keep one local connection open while any FBDEV viewer has finished the RFB
+// handshake. Kodi replies after swapping a linear GUI frame.
+static const char kodiGuiSocket[] = "\0kodi.aml-vnc.fb0.v1";
+static int kodiGuiFd = -1;
+static int kodiGuiReady = 0;
+static uint64_t kodiGuiRetry = 0;
+static uint64_t kodiGuiDeadline = 0;
+static uint64_t kodiGuiReconnectDeadline = 0;
+
+static uint64_t monotonicUs(void) {
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return (uint64_t)now.tv_sec * 1000000ULL + now.tv_nsec / 1000ULL;
+}
+
+static void closeKodiGui(void) {
+	if (kodiGuiFd >= 0)
+		close(kodiGuiFd);
+	kodiGuiFd = -1;
+	kodiGuiReady = 0;
+}
+
+static void connectKodiGui(uint64_t now) {
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	memcpy(address.sun_path, kodiGuiSocket, sizeof(kodiGuiSocket));
+	socklen_t length = offsetof(struct sockaddr_un, sun_path) + sizeof(kodiGuiSocket) - 1;
+	int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+	if (fd < 0)
+		return;
+
+	struct ucred credentials;
+	socklen_t credentialLength = sizeof(credentials);
+	if (connect(fd, (const struct sockaddr*)&address, length) < 0 ||
+	    getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &credentials, &credentialLength) < 0 ||
+	    credentials.uid != geteuid()) {
+		close(fd);
+		return;
+	}
+
+	kodiGuiFd = fd;
+	kodiGuiDeadline = now + 2000000ULL;
+	kodiGuiReconnectDeadline = 0;
+}
+
+enum kodiGuiState { GUI_CAPTURE, GUI_WAIT, GUI_REFRESH };
+
+static enum kodiGuiState pollKodiGui(uint64_t now) {
+	if (kodiGuiFd < 0 && now >= kodiGuiRetry) {
+		kodiGuiRetry = now + 250000ULL;
+		connectKodiGui(now);
+	}
+	if (kodiGuiFd < 0)
+		return now < kodiGuiReconnectDeadline ? GUI_WAIT : GUI_CAPTURE;
+
+	char reply;
+	ssize_t received = recv(kodiGuiFd, &reply, 1, 0);
+	if (received == 1 && reply == 'R' && !kodiGuiReady) {
+		kodiGuiReady = 1;
+		return GUI_REFRESH;
+	} else if (received >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) {
+		closeKodiGui();
+		kodiGuiReconnectDeadline = now + 2000000ULL;
+		return GUI_WAIT;
+	}
+	// Keep trying for a fresh frame, but allow ordinary FBDEV capture if the
+	// GUI cannot render for an extended period (for example, in standby).
+	return !kodiGuiReady && now < kodiGuiDeadline ? GUI_WAIT : GUI_CAPTURE;
+}
+
+static void processFbdevInput(long usec) {
+	// This server runs LibVNCServer in the foreground. Separate input from
+	// rfbUpdateClient so disconnects and authentication still run during the
+	// wait and no queued framebuffer request can overtake the first capture.
+	rfbCheckFds(vncScreen, usec);
+	rfbHttpCheckFds(vncScreen);
+	for (rfbClientPtr client = vncScreen->clientHead, next; client; client = next) {
+		next = client->next;
+		if (client->sock == RFB_INVALID_SOCKET)
+			rfbClientConnectionGone(client);
+	}
+}
+
+static int hasFbdevViewer(void) {
+	for (rfbClientPtr client = vncScreen->clientHead; client; client = client->next) {
+		if (client->state == RFB_NORMAL && !client->onHold)
+			return 1;
+	}
+	return 0;
+}
