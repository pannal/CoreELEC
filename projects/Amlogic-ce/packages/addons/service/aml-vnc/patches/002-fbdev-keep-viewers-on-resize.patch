+		fbBufferMap = mapping;
+		fbSize = (size_t)size;
+		fbStart = fix.smem_start;
+	}
+	varInfo = var;
+	screenInfo.width = var.xres;
+	screenInfo.height = var.yres;
+	screenInfo.stride = fix.line_length;
+	screenInfo.start = var.yoffset;
+	return 0;
