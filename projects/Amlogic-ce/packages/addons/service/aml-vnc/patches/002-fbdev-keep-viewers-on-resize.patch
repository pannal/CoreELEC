+static int sameLayout(const struct fb_var_screeninfo *a, const struct fb_var_screeninfo *b) {
+	return a->xres == b->xres && a->yres == b->yres &&
+	       a->xres_virtual == b->xres_virtual && a->yres_virtual == b->yres_virtual &&
+	       a->bits_per_pixel == b->bits_per_pixel &&
+	       !memcmp(&a->red, &b->red, sizeof(a->red)) &&
+	       !memcmp(&a->green, &b->green, sizeof(a->green)) &&
+	       !memcmp(&a->blue, &b->blue, sizeof(a->blue));
+}
+
+// The variable and fixed ioctls can briefly be out of step during a resize.
+static int refreshFbdev(void) {
+	struct fb_var_screeninfo before, var;
+	struct fb_fix_screeninfo fix;
+	if (ioctl(fbFd, FBIOGET_VSCREENINFO, &before) < 0 ||
+	    ioctl(fbFd, FBIOGET_FSCREENINFO, &fix) < 0 ||
+	    ioctl(fbFd, FBIOGET_VSCREENINFO, &var) < 0 || !sameLayout(&before, &var))
+		return -1;
+
+	const uint64_t size = (uint64_t)fix.line_length * var.yres_virtual;
+	if (var.bits_per_pixel != BPP || !var.xres || !var.yres ||
+	    var.xres > UINT16_MAX || var.yres > UINT16_MAX ||
+	    (uint64_t)var.xres * var.yres > INT_MAX / sizeof(uint32_t) ||
+	    (uint64_t)var.yoffset + var.yres > var.yres_virtual ||
+	    (uint64_t)var.xoffset + var.xres > var.xres_virtual ||
+	    (uint64_t)var.xres_virtual * sizeof(uint32_t) > fix.line_length ||
+	    fix.line_length % sizeof(uint32_t) || !size || size > fix.smem_len ||
+	    !var.red.length || var.red.length > 8 || var.red.offset > BPP - var.red.length ||
+	    !var.green.length || var.green.length > 8 || var.green.offset > BPP - var.green.length ||
+	    !var.blue.length || var.blue.length > 8 || var.blue.offset > BPP - var.blue.length)
+		return -1;
+
+	if (fbBufferMap == MAP_FAILED || fbSize != size || fbStart != fix.smem_start) {
+		void *mapping = mmap(NULL, (size_t)size, PROT_READ, MAP_SHARED, fbFd, 0);
+		if (mapping == MAP_FAILED)
