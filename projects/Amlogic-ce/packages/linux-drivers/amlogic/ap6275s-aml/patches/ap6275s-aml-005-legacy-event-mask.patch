Subject: [PATCH] wifi: Register core events on legacy firmware

Use the fixed event_msgs mask only when event_msgs_ext reports unsupported
or a version mismatch. Preserve existing bits and program the same core
events, with bounded I/O lengths and normal error propagation. Extended
events remain available on firmware that supports the newer command.

--- a/bcmdhd.101.10.591.x/dhd_linux.c
+++ b/bcmdhd.101.10.591.x/dhd_linux.c
@@ -11722,6 +11722,51 @@
 }
 #endif /* DHD_PREINIT_OPTIMISATION */
 
+/* Older AM6B+ firmware may expose only the fixed 128-bit event_msgs mask. */
+static int
+dhd_p3i_read_event_mask(dhd_pub_t *dhd, eventmsgs_ext_t *message, int msglen,
+	char *buffer, int buflen, bool *legacy)
+{
+	int ret;
+
+	*legacy = FALSE;
+	if (msglen != EVENTMSGS_EXT_STRUCT_SIZE + WL_EVENTING_MASK_EXT_LEN ||
+		buflen < msglen || WL_EVENTING_MASK_LEN > WL_EVENTING_MASK_EXT_LEN)
+		return BCME_BADLEN;
+
+	memset(buffer, 0, buflen);
+	ret = dhd_iovar(dhd, 0, "event_msgs_ext", (char *)message, msglen,
+		buffer, buflen, FALSE);
+	if (ret == BCME_OK) {
+		memcpy(message, buffer, msglen);
+		return ret;
+	}
+	if (ret != BCME_UNSUPPORTED && ret != BCME_VERSION)
+		return ret;
+
+	*legacy = TRUE;
+	memset(message->mask, 0, WL_EVENTING_MASK_EXT_LEN);
+	return dhd_iovar(dhd, 0, "event_msgs", NULL, 0, (char *)message->mask,
+		WL_EVENTING_MASK_LEN, FALSE);
+}
+
+static int
+dhd_p3i_write_event_mask(dhd_pub_t *dhd, eventmsgs_ext_t *message, int msglen,
+	bool legacy)
+{
+	if (msglen != EVENTMSGS_EXT_STRUCT_SIZE + WL_EVENTING_MASK_EXT_LEN)
+		return BCME_BADLEN;
+	if (legacy)
+		return dhd_iovar(dhd, 0, "event_msgs", (char *)message->mask,
+			WL_EVENTING_MASK_LEN, NULL, 0, TRUE);
+
+	message->ver = EVENTMSGS_VER;
+	message->command = EVENTMSGS_SET_MASK;
+	message->len = WL_EVENTING_MASK_EXT_LEN;
+	return dhd_iovar(dhd, 0, "event_msgs_ext", (char *)message, msglen,
+		NULL, 0, TRUE);
+}
+
 static int
