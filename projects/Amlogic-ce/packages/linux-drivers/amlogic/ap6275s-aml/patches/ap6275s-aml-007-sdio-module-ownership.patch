Subject: [PATCH] wifi: Associate SDIO drivers with their owning module

The CE 4.9 SDIO registration helper does not fill driver.owner. Set it
explicitly so the bound SDIO driver exposes driver/module for the Settings
capability lookup. Preserve PM operations and cover the temporary driver
used during enumeration as well.

--- a/bcmdhd.100.10.545.x/bcmsdh_sdmmc_linux.c
+++ b/bcmdhd.100.10.545.x/bcmsdh_sdmmc_linux.c
@@ -296,6 +296,9 @@
 	.remove		= dummy_remove,
 	.name		= "dummy_sdmmc",
 	.id_table	= bcmsdh_sdmmc_ids,
+	.drv = {
+		.owner = THIS_MODULE,
+	},
 	};
 
 int sdio_func_reg_notify(void* semaphore)
@@ -317,11 +320,12 @@
 	.remove		= bcmsdh_sdmmc_remove,
 	.name		= "bcmsdh_sdmmc",
 	.id_table	= bcmsdh_sdmmc_ids,
+	.drv = {
+		.owner = THIS_MODULE,
 #if (LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 39)) && defined(CONFIG_PM)
-	.drv = {
-	.pm	= &bcmsdh_sdmmc_pm_ops,
+		.pm = &bcmsdh_sdmmc_pm_ops,
+#endif /* (LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 39)) && defined(CONFIG_PM) */
 	},
-#endif /* (LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 39)) && defined(CONFIG_PM) */
 	};
 
 struct sdos_info {
