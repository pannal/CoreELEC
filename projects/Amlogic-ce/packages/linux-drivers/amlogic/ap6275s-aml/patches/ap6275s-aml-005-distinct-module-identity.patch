Subject: [PATCH] wifi: Build SDIO with a distinct kernel module identity

Use dhd_sdio as the real Kbuild module name. The bus translation unit
is renamed during unpacking so the composite has no self-dependency.

--- a/bcmdhd.100.10.545.x/Makefile
+++ b/bcmdhd.100.10.545.x/Makefile
@@ -7,7 +7,7 @@
 endif
 
 ifeq ($(CONFIG_BCMDHD_SDIO),y)
-MODULE_NAME := dhd
+MODULE_NAME := dhd_sdio
 else
 ifeq ($(CONFIG_BCMDHD_USB),y)
 MODULE_NAME := bcmdhd
@@ -97,7 +97,7 @@
 	DHDCFLAGS += -DSDIO_ISR_THREAD
 endif
 DHDOFILES += bcmsdh.o bcmsdh_linux.o bcmsdh_sdmmc.o bcmsdh_sdmmc_linux.o  \
-	dhd_sdio.o dhd_cdc.o dhd_wlfc.o
+	dhd_sdio_bus.o dhd_cdc.o dhd_wlfc.o
 endif
 
 #BCMDHD_PCIE
@@ -276,7 +276,7 @@
 
 bcmdhd_sdio:
 	$(MAKE) -C $(KERNEL_SRC) M=$(M) CONFIG_DHD_USE_STATIC_BUF=y CONFIG_BCMDHD_SDIO=y modules
-	$(CROSS_COMPILE)strip --strip-unneeded ${OUT_DIR}/$(M)/dhd.ko
+	$(CROSS_COMPILE)strip --strip-unneeded ${OUT_DIR}/$(M)/$(MODULE_NAME).ko
 
 bcmdhd_usb:
 	$(MAKE) -C $(KDIR) M=$(PWD) ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) modules CONFIG_BCMDHD_USB=y
