Subject: [PATCH] wifi: Retain tested CE SDIO startup and ownership

Keep the existing ten device IDs and deliberate autoload policy. Retain
the bounded startup wait, truthful module ownership and the tested Amlogic
power settling sequence instead of importing Android timing assumptions.

--- a/bcmdhd.101.10.591.x/bcmsdh_sdmmc_linux.c
+++ b/bcmdhd.101.10.591.x/bcmsdh_sdmmc_linux.c
@@ -245,36 +245,17 @@
 
 /* devices we support, null terminated */
 static const struct sdio_device_id bcmsdh_sdmmc_ids[] = {
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, SDIO_DEVICE_ID_BROADCOM_DEFAULT) },
-	/* XXX This should not be in the external release, as it will attach to any SDIO
-	 * device, even non-WLAN devices.
-	 * Need to add IDs for the FALCON-based chips and put this under BCMINTERNAL
-	 { SDIO_DEVICE_CLASS(SDIO_CLASS_NONE) },
-	 */
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM4339_CHIP_ID) },
 	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM4354_CHIP_ID) },
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM4359_CHIP_ID) },
 	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM4362_CHIP_ID) },
 	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43751_CHIP_ID) },
 	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43752_CHIP_ID) },
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43756_CHIP_ID) },
 	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43012_CHIP_ID) },
 	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43014_CHIP_ID) },
 	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43014_D11N_ID) },
 	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43014_D11N2G_ID) },
 	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43014_D11N5G_ID) },
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43013_CHIP_ID) },
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43013_D11N_ID) },
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43013_D11N2G_ID) },
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43013_D11N5G_ID) },
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM4381_CHIP_ID) },
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM4382_CHIP_ID) },
 	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, BCM43455_D11AC_V2_ID) },
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_SYNAPTICS, BCM43711_CHIP_ID) },
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_SYNAPTICS, BCM4612_CHIP_ID) },
-	{ SDIO_DEVICE(SDIO_VENDOR_ID_BROADCOM, SDIO_ANY_ID) },
-	{ 0, 0, 0, 0 /* end: all zeroes */
-	},
+	{ 0, 0, 0, 0 },
 };
 
 MODULE_DEVICE_TABLE(sdio, bcmsdh_sdmmc_ids);
@@ -422,6 +403,9 @@
 	.remove		= dummy_remove,
 	.name		= "dummy_sdmmc",
 	.id_table	= bcmsdh_sdmmc_ids,
+	.drv = {
+		.owner = THIS_MODULE,
+	},
 };
 
 int sdio_func_reg_notify(void* semaphore)
@@ -443,11 +427,12 @@
 	.remove		= bcmsdh_sdmmc_remove,
 	.name		= "bcmsdh_sdmmc"ADAPTER_IDX_STR,
 	.id_table	= bcmsdh_sdmmc_ids,
+	.drv = {
+		.owner = THIS_MODULE,
 #if (LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 39)) && defined(CONFIG_PM_SLEEP)
-	.drv = {
-	.pm	= &bcmsdh_sdmmc_pm_ops,
+		.pm = &bcmsdh_sdmmc_pm_ops,
+#endif /* (LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 39)) && defined(CONFIG_PM_SLEEP) */
 	},
-#endif /* (LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 39)) && defined(CONFIG_PM_SLEEP) */
 	};
 
 struct sdos_info {
--- a/bcmdhd.101.10.591.x/dhd_gpio.c
+++ b/bcmdhd.101.10.591.x/dhd_gpio.c
@@ -82,14 +82,9 @@
 #ifdef CUSTOMER_HW_AMLOGIC
 #ifdef BCMSDIO
 		extern_wifi_set_enable(0);
-		mdelay(WIFI_TURNOFF_DELAY);
+		mdelay(200);
 		extern_wifi_set_enable(1);
-#ifdef CONFIG_HIBERNATION
-		printf("###mdelay(200)\n");
-		mdelay(WIFI_TURNON_DELAY);
-		printf("###sdio_reinit(), but not need\n");
-		//sdio_reinit();
-#endif
+		mdelay(200);
 #endif
 #ifdef BCMDBUS
 		if (dhd_pwr_ctrl) {
@@ -120,7 +115,8 @@
 		}
 #endif /* BCMPCIE */
 #endif /* BUS_POWER_RESTORE */
-		/* Lets customer power to get stable */
+		/* Preserve the proven CE power-on settling interval. */
+		mdelay(100);
 	} else {
 #ifdef BUS_POWER_RESTORE
 #ifdef BCMPCIE
@@ -145,6 +141,7 @@
 #ifdef CUSTOMER_HW_AMLOGIC
 #ifdef BCMSDIO
 		extern_wifi_set_enable(0);
+		mdelay(200);
 #endif
 #ifdef BCMDBUS
 		if (dhd_pwr_ctrl) {
--- a/bcmdhd.101.10.591.x/dhd_linux.c
+++ b/bcmdhd.101.10.591.x/dhd_linux.c
@@ -7133,7 +7133,7 @@
 	int bytes_written = 0;
 #endif
 	int retry = POWERUP_MAX_RETRY;
-	int retry_init;
+	unsigned long init_deadline;
 
 #if defined(PREVENT_REOPEN_DURING_HANG)
 	/* WAR : to prevent calling dhd_open abnormally in quick succession after hang event */
@@ -7182,18 +7182,15 @@
 			dhd->wl_accel_force_reg_on = TRUE;
 		}
 #endif /* WLAN_ACCEL_BOOT */
-		for (retry_init = 0; ++retry_init; ) {
-			if (!dhd_download_fw_on_driverload && !dhd_driver_init_done) {
+		/* Registration and deferred power-off must finish before opening. */
+		init_deadline = jiffies + msecs_to_jiffies(3000);
+		while (!READ_ONCE(dhd_driver_init_done)) {
+			if (time_after_eq(jiffies, init_deadline)) {
 				DHD_ERROR(("%s: WLAN driver is not initialized\n", __FUNCTION__));
-				if (retry_init > 3) {
-					mutex_unlock(&dhd->pub.ndev_op_sync);
-					return -1;
-				} else {
-					OSL_SLEEP(1000);
-				}
-			} else {
-				break;
+				mutex_unlock(&dhd->pub.ndev_op_sync);
+				return -1;
 			}
+			OSL_SLEEP(20);
 		}
 	}
 
@@ -7587,10 +7584,10 @@
 	} else {
 #if defined(ENABLE_INSMOD_NO_FW_LOAD) && defined(NO_POWER_OFF_AFTER_OPEN)
 		dhd_download_fw_on_driverload = TRUE;
-		dhd_driver_init_done = TRUE;
+		WRITE_ONCE(dhd_driver_init_done, TRUE);
 #elif defined(ENABLE_INSMOD_NO_FW_LOAD) && defined(ENABLE_INSMOD_NO_POWER_OFF)
 		dhd_download_fw_on_driverload = FALSE;
-		dhd_driver_init_done = TRUE;
+		WRITE_ONCE(dhd_driver_init_done, TRUE);
 #endif
 	}
 
@@ -15140,7 +15137,7 @@
 		DHD_ERROR(("%s: Failed to load driver max retry reached**\n", __FUNCTION__));
 	} else {
 		if (!dhd_download_fw_on_driverload) {
-			dhd_driver_init_done = TRUE;
+			WRITE_ONCE(dhd_driver_init_done, TRUE);
 		}
 	}
 
