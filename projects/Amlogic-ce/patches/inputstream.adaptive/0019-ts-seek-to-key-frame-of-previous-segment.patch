diff --git a/src/test/TestTSReader.cpp b/src/test/TestTSReader.cpp
index d5f689c..0af276f 100644
--- a/src/test/TestTSReader.cpp
+++ b/src/test/TestTSReader.cpp
@@ -1271,6 +1271,228 @@ TEST_F(TSSampleReaderTest, PtsDiffOfAPesHeaderAcrossTwoSegments)
   EXPECT_EQ(frame, 2 * SEGMENT_VIDEO_FRAMES);
