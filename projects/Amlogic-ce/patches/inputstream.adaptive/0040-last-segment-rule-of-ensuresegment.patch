From 7a4f916b18c598ce7a1bea6bb8284270abb10dd7 Mon Sep 17 00:00:00 2001
From: primez <mpincoski@gmail.com>
Date: Sat, 31 Oct 2026 08:44:27 -0600
Subject: [PATCH 40/41] [AdaptiveStream] Tell the last segment with the rule
 that loads the next segment

IsLastSegment asked only the tree. For a live DASH period with a
presentationTimeOffset before the last period, the tree compares segment
times that include the offset with the period end, and so called the first
segments of the period the last. The TS reader then flushed an E-AC-3
access unit across those segments as two samples.

IsLastSegment now uses the same rule as ensureSegment: a segment follows
when the timeline has a next segment, or when a manifest update can add
one. Both share CanAddLiveSegment.

The TS reader tests convert the packet duration without a narrowing warning.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/AdaptiveStream.cpp | 12 +++++--
 src/common/AdaptiveStream.h   |  4 +++
 src/test/TestDASHTree.cpp     | 54 ++++++++++++++++++++++++++++++
 src/test/TestHLSTree.cpp      | 62 +++++++++++++++++++++++++++++++++++
 src/test/TestTSReader.cpp     |  9 +++--
 5 files changed, 135 insertions(+), 6 deletions(-)

diff --git a/src/common/AdaptiveStream.cpp b/src/common/AdaptiveStream.cpp
index 1515dde..b8d8146 100644
--- a/src/common/AdaptiveStream.cpp
+++ b/src/common/AdaptiveStream.cpp
@@ -902,8 +902,7 @@ bool AdaptiveStream::ensureSegment()
     else
       nextSegment = current_rep_->GetNextSegment();
 
-    if (!nextSegment && (m_tree->HasManifestUpdates() || m_tree->HasManifestUpdatesSegs()) &&
-        !m_tree->IsLastSegment(current_period_, current_rep_, current_rep_->current_segment_))
+    if (!nextSegment && CanAddLiveSegment())
     {
       // Ensure to add a new segment only when the last one in the buffer has been consumed
       if (available_segment_buffers_ == 0)
@@ -1334,7 +1333,14 @@ bool AdaptiveStream::IsLastSegment() const
   if (!current_rep_)
     return true;
   std::lock_guard<adaptive::AdaptiveTree::TreeUpdateThread> lckUpdTree(m_tree->GetTreeUpdMutex());
-  return m_tree->IsLastSegment(current_period_, current_rep_, current_rep_->current_segment_);
+  // The same rule as ensureSegment, which loads the next segment
+  return !current_rep_->GetNextSegment() && !CanAddLiveSegment();
+}
+
+bool AdaptiveStream::CanAddLiveSegment() const
+{
+  return (m_tree->HasManifestUpdates() || m_tree->HasManifestUpdatesSegs()) &&
+         !m_tree->IsLastSegment(current_period_, current_rep_, current_rep_->current_segment_);
 }
 
 bool AdaptiveStream::waitingForSegment() const
diff --git a/src/common/AdaptiveStream.h b/src/common/AdaptiveStream.h
index 1d195a7..b5cfa9b 100644
--- a/src/common/AdaptiveStream.h
+++ b/src/common/AdaptiveStream.h
@@ -147,6 +147,10 @@ enum class EVENT_TYPE
     bool IsRequiredCreateMovieAtom();
 
   protected:
+    /*!
+     * \brief True if a manifest update can add a segment after the current segment
+     */
+    bool CanAddLiveSegment() const;
     virtual bool parseIndexRange(PLAYLIST::CRepresentation* rep,
                                  const std::vector<uint8_t>& buffer);
 
diff --git a/src/test/TestDASHTree.cpp b/src/test/TestDASHTree.cpp
index fc33621..f7e06b8 100644
--- a/src/test/TestDASHTree.cpp
+++ b/src/test/TestDASHTree.cpp
@@ -782,3 +782,57 @@ TEST_F(DASHTreeTest, TSBAvailabilityStartTime)
