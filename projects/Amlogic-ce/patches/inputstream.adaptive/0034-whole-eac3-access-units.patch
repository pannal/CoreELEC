+// The end of a segment can come between the frames of an E-AC-3 access unit.
+// With the start of a dependent header after the frame, the parser keeps the
+// frame for the rest of the access unit in the next segment. A frame with no
+// data after the frame, or with other data, comes at the end of the data: the
+// end of the stream looks the same. Then a dependent frame in the next data
+// has no frame before.
+TEST(TSParserTest, AnEAc3AccessUnitWaitsForTheRestAtTheEndOfTheData)
+{
+  for (const size_t split : {size_t{128}, size_t{129}, size_t{130}, size_t{134}, size_t{200}})
+  {
+    SCOPED_TRACE(testing::Message() << "end after " << split << " bytes");
+    std::vector<uint8_t> data{Eac3AccessUnit(0)};
+    const std::vector<uint8_t> next{Eac3AccessUnit(1)};
+    data.insert(data.end(), next.begin(), next.end());
+    TSDemux::ES_AC3 stream{AUDIO_PID};
+    stream.c_pts = stream.c_dts = 90000;
+    stream.StartPes(0, 0);
+    stream.Append(data.data(), split, true);
+    std::vector<AudioFrame> read;
+    TSDemux::STREAM_PKT pkt;
+    const auto readFrames = [&](bool end)
+    {
+      while (read.size() < 10 && (stream.GetStreamPacket(&pkt) || (end && stream.GetEndPacket(&pkt))))
+        read.push_back({static_cast<unsigned int>(pkt.size), pkt.pts, pkt.duration});
+    };
+    readFrames(true);
+    stream.Append(data.data() + split, data.size() - split, false);
+    readFrames(true);
+    EXPECT_EQ(read, (std::vector<AudioFrame>{{split == 128 ? 128U : 256U, 90000, EAC3_TICKS},
+                                             {256, 90000 + EAC3_TICKS, EAC3_TICKS}}));
+  }
+  // Other data after the frame
+  std::vector<uint8_t> data{Eac3Frame(0)};
+  data.insert(data.end(), {0x00, 0x00, 0x00});
+  TSDemux::ES_AC3 stream{AUDIO_PID};
+  EXPECT_EQ(ReadAudioFrames(stream, data), (std::vector<AudioFrame>{{128, 90000, EAC3_TICKS}}));
 }
 
