From 63aaf327272256cc45e02692a5e04145852e3d71 Mon Sep 17 00:00:00 2001
From: primez <mpincoski@gmail.com>
Date: Sat, 31 Oct 2026 06:37:05 -0600
Subject: [PATCH] [TSReader] Keep every audio frame of a PES across repeated
 live waits

A repeated live wait keeps the frames of the last PES of a stream without
new frames. The check for new frames also saw the frames that the loop had
just kept, so the stream kept only the first frame of the PES. With two
frames of an audio PES before the segment boundary, the second frame was
lost.

Find the streams with new frames before the frames are kept.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 inputstream.adaptive/changelog.txt |  2 +-
 src/demuxers/TSReader.cpp          |  8 +++++---
 src/test/TestTSReader.cpp          | 13 ++++++++-----
 3 files changed, 14 insertions(+), 9 deletions(-)

diff --git a/inputstream.adaptive/changelog.txt b/inputstream.adaptive/changelog.txt
index 069493e..967e1bc 100644
--- a/inputstream.adaptive/changelog.txt
+++ b/inputstream.adaptive/changelog.txt
@@ -23,7 +23,7 @@ v21.5.25-p3i.4 (2026-10-31)
 - Fix the timestamps of TS video and audio frames that the parser read only after the next PES started, which took the PTS of the next frame, as with HEVC access unit delimiters or parameter sets in a PES of their own, or with an audio frame header across two PES
 - Fix the last frame of a TS segment or stream whose parameter sets came in a PES of their own, which was read as two frames
 - Fix a seek in a TS stream to a key frame whose picture PES starts in the next segment, which returned that key frame twice
-- Fix a live seek in a TS stream that waited more than once for the next segment, which lost the first audio frame of an audio PES across the two segments
+- Fix a live seek in a TS stream that waited more than once for the next segment, which lost audio frames of an audio PES across the two segments
 - Fix the segment times of HLS streams with EXTINF durations finer than 1 ms, which drifted from the media time (0.24 s after one hour of a YouTube stream), so a seek near a segment start could continue at the next segment
 
 v21.5.25-p3i.3 (2026-10-30)
diff --git a/src/demuxers/TSReader.cpp b/src/demuxers/TSReader.cpp
index e6b20d6..cd16a1b 100644
--- a/src/demuxers/TSReader.cpp
+++ b/src/demuxers/TSReader.cpp
@@ -15,6 +15,7 @@
 
 #include <algorithm>
 #include <map>
+#include <set>
 #include <stdlib.h>
 
 #include <bento4/Ap4ByteStream.h>
@@ -288,11 +289,12 @@ bool TSReader::SeekTime(uint64_t timeInTs, bool preceeding)
       copies.clear();
       // A stream without frames since then, as when a live seek waits again,
       // keeps the frames of its last PES
+      std::set<uint16_t> pidsWithFrames;
+      for (const FrameCopy& last : lastPesFrames)
+        pidsWithFrames.insert(last.pkt.pid);
       for (FrameCopy& frame : previousPesFrames)
       {
-        const uint16_t pid{frame.pkt.pid};
-        if (std::none_of(lastPesFrames.begin(), lastPesFrames.end(),
-                         [pid](const FrameCopy& last) { return last.pkt.pid == pid; }))
+        if (!pidsWithFrames.count(frame.pkt.pid))
           lastPesFrames.push_back(std::move(frame));
       }
       previousPesFrames = std::move(lastPesFrames);
diff --git a/src/test/TestTSReader.cpp b/src/test/TestTSReader.cpp
index eca2587..5717d52 100644
--- a/src/test/TestTSReader.cpp
+++ b/src/test/TestTSReader.cpp
@@ -1739,7 +1739,9 @@ TEST_F(TSSampleReaderTest, SeekToAKeyFrameAcrossTwoSegmentsKeepsTheAudioAcrossTh
   constexpr int SPLIT_FRAMES{4};
   // The audio of the next segment comes before or after the video of a frame.
   // With the video first, the rest of the audio PES comes after the next video PES.
-  // A live seek waits for the next segment, also over more reads.
+  // A live seek waits for the next segment, also over more reads. The first
+  // segment holds one or more frames of the audio PES.
+  for (const size_t audioSplit : {size_t{188}, size_t{376}})
   for (const bool live : {false, true})
   for (const int waitReads : {0, 2})
   for (const bool audioFirst : {true, false})
@@ -1747,7 +1749,8 @@ TEST_F(TSSampleReaderTest, SeekToAKeyFrameAcrossTwoSegmentsKeepsTheAudioAcrossTh
   {
     if (!live && waitReads)
       continue;
-    SCOPED_TRACE(testing::Message() << (audioFirst ? "audio first" : "video first")
+    SCOPED_TRACE(testing::Message() << audioSplit << " audio bytes, "
+                                    << (audioFirst ? "audio first" : "video first")
                                     << (preceeding ? "" : ", not preceeding")
                                     << (live ? ", live" : "") << ", " << waitReads
                                     << " wait reads");
@@ -1767,12 +1770,12 @@ TEST_F(TSSampleReaderTest, SeekToAKeyFrameAcrossTwoSegmentsKeepsTheAudioAcrossTh
                       false);
     const std::vector<uint8_t> audio{writer.Take()};
     first.insert(first.end(), keyFrame.begin(), keyFrame.begin() + 188);
-    first.insert(first.end(), audio.begin(), audio.begin() + 188);
+    first.insert(first.end(), audio.begin(), audio.begin() + audioSplit);
     writer.WriteTables(true);
     std::vector<uint8_t> second{writer.Take()};
     second.insert(second.end(), keyFrame.begin() + 188, keyFrame.end());
     if (audioFirst)
-      second.insert(second.end(), audio.begin() + 188, audio.end());
+      second.insert(second.end(), audio.begin() + audioSplit, audio.end());
     for (int v = SEGMENT_VIDEO_FRAMES; v < 2 * SEGMENT_VIDEO_FRAMES; ++v)
     {
       const int a{2 * v + SPLIT_FRAMES};
@@ -1782,7 +1785,7 @@ TEST_F(TSSampleReaderTest, SeekToAKeyFrameAcrossTwoSegmentsKeepsTheAudioAcrossTh
       {
         const std::vector<uint8_t> video{writer.Take()};
         second.insert(second.end(), video.begin(), video.end());
-        second.insert(second.end(), audio.begin() + 188, audio.end());
+        second.insert(second.end(), audio.begin() + audioSplit, audio.end());
       }
       writer.WriteAudio(AudioPts(a) - AUDIO_LEAD, a, 2, 1, false);
       if (audioFirst)
