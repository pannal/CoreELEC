+    CkB64Decode(b64Key);
+    BASE64::AddPadding(b64Key);
+    CkB64Decode(b64KeyId);
+    BASE64::AddPadding(b64KeyId);
+
+    const std::vector<uint8_t> kidBytes = BASE64::Decode(b64KeyId);
