From de0e18b8838217557c3351794b7878a1badcebbe Mon Sep 17 00:00:00 2001
From: primez <mpincoski@gmail.com>
Date: Sat, 31 Oct 2026 13:52:49 -0600
Subject: [PATCH] [Session] Drop a kept seek at a chapter change and when the
 streams are deleted

- DeleteStreams clears m_timingStream and the kept seek, and
  InitializePeriod deletes the streams through DeleteStreams. After
  OnGetStream deleted the streams (a missing decrypter), a PosTime or the
  replay of a kept seek read the freed timing stream.
- A chapter change (a chapter that the user selects, the end of a chapter,
  or a seek into another period) drops the kept seek, and OnDemuxRead
  replays no kept seek while a period switch runs. Before, the replay moved
  the playback back to the old chapter.
- CInputStreamAdaptive::SeekChapter drops a failed seek that waits for a
  retry, for the same reason.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 inputstream.adaptive/changelog.txt | 2 ++
 src/Session.cpp                    | 9 +++++++--
 src/main.cpp                       | 6 +++++-
 3 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/inputstream.adaptive/changelog.txt b/inputstream.adaptive/changelog.txt
index 6b96a34..3c8feb8 100644
--- a/inputstream.adaptive/changelog.txt
+++ b/inputstream.adaptive/changelog.txt
@@ -17,6 +17,8 @@ v21.5.25-p3i.4 (2026-10-31)
 - Fix a seek during a change of the stream quality, which continued at the start of the segment instead of at the seek time
 - Fix wrong stream times, a wrong seek limit of a live stream and seeks to the wrong segment with a high timescale or large times (for example times from 1970 at 90 kHz), where a time conversion overflowed
 - Fix a DASH SegmentList without a timescale, whose segment times counted in microseconds instead of seconds
+- Fix a possible crash at a seek after the playback stopped for a missing decrypter
+- Fix a chapter selection after a failed seek, which returned to the time of the failed seek
 - Fix a seek to an earlier time inside the current segment, which continued at the start of the segment instead of at the frame of the seek time
 - Fix a seek in a TS stream with video and audio that returned an audio frame first, so the other streams aligned to the audio time instead of the video frame of the seek
 - Fix a seek in an HEVC or MPEG-2 TS stream, which continued at the segment start instead of at the key frame of the seek time
diff --git a/src/Session.cpp b/src/Session.cpp
index afce38c..cef01b6 100644
--- a/src/Session.cpp
+++ b/src/Session.cpp
@@ -85,6 +85,9 @@ CSession::~CSession()
 void SESSION::CSession::DeleteStreams()
 {
   LOG::Log(LOGDEBUG, "CSession::DeleteStreams()");
+  // The timing stream and a kept seek refer to the streams
+  m_timingStream = nullptr;
+  m_changeSeek.reset();
   m_streams.clear();
 }
 
@@ -620,7 +623,7 @@ bool CSession::InitializePeriod(bool isSessionOpened /* = false */)
   }
 
   // create SESSION::STREAM objects. One for each AdaptationSet
-  m_streams.clear();
+  DeleteStreams();
 
   if (!isPsshChanged)
   {
@@ -1346,7 +1349,7 @@ void CSession::OnDemuxRead()
 
   // A seek at a pending change of the representation continues after the reopen
   // of the changed streams: the new reader starts at the start of the segment
-  if (m_changeSeek &&
+  if (m_changeSeek && !m_adaptiveTree->IsChangingPeriod() &&
       std::none_of(m_streams.cbegin(), m_streams.cend(), [](const auto& stream)
                    { return stream->m_isEnabled && stream->m_adStream.StreamChanged(); }))
   {
@@ -1574,6 +1577,8 @@ bool CSession::SeekChapter(int ch)
   {
     CPeriod* nextPeriod = m_adaptiveTree->m_periods[ch].get();
     m_adaptiveTree->m_nextPeriod = nextPeriod;
+    // The new period replaces a seek that waits for the reopen of a stream
+    m_changeSeek.reset();
     LOG::LogF(LOGDEBUG, "Switching to new Period (id=%s, start=%llu, seq=%u)",
               nextPeriod->GetId().data(), nextPeriod->GetStart(), nextPeriod->GetSequence());
 
diff --git a/src/main.cpp b/src/main.cpp
index 75b4f7d..f0626bb 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -528,7 +528,11 @@ int64_t CInputStreamAdaptive::GetChapterPos(int ch)
 
 bool CInputStreamAdaptive::SeekChapter(int ch)
 {
-  return m_session ? m_session->SeekChapter(ch) : false;
+  if (!m_session || !m_session->SeekChapter(ch))
+    return false;
+  // The chapter replaces the retry of a failed seek
+  m_failedSeekTime = ~0;
+  return true;
 }
 #endif
 /*****************************************************************************************************/
