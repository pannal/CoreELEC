+  // last audio PES waits in the buffer for the next audio PES.
+  std::vector<std::pair<AP4_UI32, uint64_t>> expected;
+  for (int v = 0; v < 24; ++v)
+    expected.emplace_back(VIDEO_ID, Time(VideoPts(v)));
