diff --git a/src/test/TestWebmReader.cpp b/src/test/TestWebmReader.cpp
new file mode 100644
index 0000000..e65d717
--- /dev/null
+++ b/src/test/TestWebmReader.cpp
@@ -0,0 +1,152 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
