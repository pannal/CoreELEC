-void TSReader::MarkSegmentStart(uint64_t offset, std::optional<uint32_t> oldestUsed)
+bool TSReader::IsPtsBefore(uint64_t pts, uint64_t other)
+{
+  const uint64_t distance{(other - pts) & PTS_MASK};
