diff --git a/src/samplereader/ADTSSampleReader.cpp b/src/samplereader/ADTSSampleReader.cpp
index b1ee5b5..bd65886 100644
--- a/src/samplereader/ADTSSampleReader.cpp
+++ b/src/samplereader/ADTSSampleReader.cpp
@@ -31,17 +31,7 @@ AP4_Result CADTSSampleReader::ReadSample()
 {
   if (ReadPacket())
   {
-    uint64_t pts{GetPts()};
-    if (pts == ADTSReader::ADTS_PTS_UNSET)
-      m_pts = STREAM_NOPTS_VALUE;
-    else
-      m_pts = (pts * 100) / 9;
-
-    if (~m_ptsOffs)
-    {
-      m_ptsDiff = m_pts - m_ptsOffs;
-      m_ptsOffs = ~0ULL;
-    }
+    UpdatePts();
     return AP4_SUCCESS;
   }
   if (!m_adByteStream || !m_adByteStream->waitingForSegment())
@@ -59,11 +49,33 @@ void CADTSSampleReader::Reset(bool bEOS)
 
 bool CADTSSampleReader::TimeSeek(uint64_t pts, bool preceeding)
 {
+  // ADTSReader::SeekTime needs a packet already read, and the first packet
+  // of a segment sets the PTS diff
+  if (AP4_FAILED(ReadSample()))
+    return false;
+
   AP4_UI64 seekPos{(pts * 9) / 100};
   if (ADTSReader::SeekTime(seekPos, preceeding))
   {
     m_started = true;
-    return AP4_SUCCEEDED(ReadSample());
+    // ADTSReader::SeekTime may have read other packets
+    UpdatePts();
+    return true;
+  }
+  return false; // EOS
+}
+
+void CADTSSampleReader::UpdatePts()
+{
+  uint64_t pts{GetPts()};
+  if (pts == ADTSReader::ADTS_PTS_UNSET)
+    m_pts = STREAM_NOPTS_VALUE;
+  else
+    m_pts = (pts * 100) / 9;
+
+  if (~m_ptsOffs)
+  {
+    m_ptsDiff = m_pts - m_ptsOffs;
+    m_ptsOffs = ~0ULL;
   }
-  return AP4_ERROR_EOS;
 }
