-      m_segmentPts = stream->c_pts;
-      m_segmentPid = stream->pid;
+      if (tsInfo.m_stream->pid == pid && tsInfo.m_enabled &&
+          (tsInfo.m_streamType == INPUTSTREAM_TYPE_VIDEO || !hasVideo))
+        return SegmentStart{pts, *segment->offset};
     }
-    return;
